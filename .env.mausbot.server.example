# ATLAS Engine Hub v0 — EXCLUSIVEMENT coté serveur.
# Copier les noms/valeurs dans un coffre de secrets serveur (Vercel env sans NEXT_PUBLIC_)
# Ne pas utiliser 127.0.0.1 pour un MAUSBOT distant hébergé sur Vercel.
ATLAS_MAUSBOT_URL=
ATLAS_MAUSBOT_TOKEN=
ATLAS_MAUSBOT_WORKSPACE_ID=
# Preconnection lock: offline by default, even if URL and paired token are present.
# A separate security review is required before changing the release stage.
ATLAS_MAUSBOT_RELEASE_STAGE=offline
# NEVER set the following without release review + tenant isolation + durable audit.
ATLAS_MAUSBOT_MUTATIONS_ACK=
