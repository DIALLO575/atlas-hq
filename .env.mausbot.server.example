# ATLAS Engine Hub v0 — EXCLUSIVEMENT coté serveur.
# Copier les noms/valeurs dans un coffre de secrets serveur (Vercel env sans NEXT_PUBLIC_)
# Ne pas utiliser 127.0.0.1 pour un MAUSBOT distant hébergé sur Vercel.
ATLAS_MAUSBOT_URL=
ATLAS_MAUSBOT_TOKEN=
ATLAS_MAUSBOT_WORKSPACE_ID=
# Preconnection lock: offline by default, even if URL and paired token are present.
# A separate security review is required before changing the release stage.
ATLAS_MAUSBOT_RELEASE_STAGE=offline
# MAUSBOT writes/execute remain BLOCKED BY CODE regardless of old ack flags.
# This preconnection stage must be replaced by a reviewed durable gate.

# Simple credential mode (future private worker): exact server-side instance binding.
# These identifiers/version are metadata; never paste a real token into this file.
ATLAS_MAUSBOT_INSTANCE_ID=
ATLAS_MAUSBOT_TOKEN_VERSION=env-v1
ATLAS_MAUSBOT_TOKEN_REVOKED=false
# Replacing env vars requires restart/redeploy of all consuming processes.
# Revoke the old token in MAUSBOT as well; env removal cannot erase in-flight copies.
