# Public configuration only. Never put service role keys or private tokens here.
# Public values only. Never put a service_role or sb_secret key in this file.
NEXT_PUBLIC_APP_NAME=ATLAS HQ
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ATLAS Engine Hub v0 — server-side ONLY. Never prefix with NEXT_PUBLIC_.
# Use one isolated MAUSBOT workspace per ATLAS workspace.
# For deployed ATLAS use an HTTPS MAUSBOT endpoint reachable from the server.
ATLAS_MAUSBOT_URL=
ATLAS_MAUSBOT_TOKEN=
ATLAS_MAUSBOT_WORKSPACE_ID=
