{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-hq/schemas/journal-edition.v1.schema.json",
  "title": "WORLD RADAR journal edition v1",
  "description": "Unique contract posted by the producer (MORGANS today, Grok Bot later) to the n8n webhook. n8n validates it strictly; ATLAS re-validates rows it reads. Additional properties are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edition_id", "generated_at", "producer", "items"],
  "properties": {
    "schema_version": { "const": "1" },
    "edition_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "enum": ["morgans", "grok-bot"] },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "title", "summary", "certainty", "status", "source_url", "source_name", "cover"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$" },
          "topic": { "type": "string", "enum": ["ia", "ia-sur-x", "commerce", "guinee", "afrique", "monde", "geopolitique", "economie", "tech"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "why_it_matters": { "type": ["string", "null"], "maxLength": 1000 },
          "certainty": { "type": "string", "enum": ["elevee", "moyenne", "faible"] },
          "status": { "type": "string", "enum": ["confirme", "rapporte", "a_verifier"] },
          "source_url": { "type": "string", "pattern": "^https?://", "maxLength": 2048 },
          "source_name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "extra_sources": {
            "type": "array", "maxItems": 8,
            "items": { "type": "object", "additionalProperties": false, "required": ["url", "name"],
              "properties": { "url": { "type": "string", "pattern": "^https?://", "maxLength": 2048 }, "name": { "type": "string", "maxLength": 120 } } }
          },
          "published_at": { "type": ["string", "null"], "format": "date-time" },
          "author_bot": { "type": ["string", "null"], "maxLength": 60 },
          "featured": { "type": "boolean", "default": false, "description": "Optionnel, rétrocompatible : dossier à la une (le premier true l’emporte ; sinon la première entrée)." },
          "cover": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "additionalProperties": false, "required": ["storage_path", "generated", "alt", "credit", "source_name"],
                "properties": {
                  "storage_path": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}/[A-Za-z0-9._-]{1,150}\\.(webp|png|jpg|jpeg)$" },
                  "generated": { "type": "boolean" },
                  "alt": { "type": "string", "maxLength": 300 },
                  "credit": { "type": ["string", "null"], "maxLength": 200 },
                  "source_name": { "type": ["string", "null"], "maxLength": 120 }
                } }
            ]
          }
        }
      }
    }
  }
}
